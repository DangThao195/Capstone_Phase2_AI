    {
      "name": "6. POST Rollback Notification",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Audit recorded successfully\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.audit_recorded).to.be.true;",
              "    pm.expect(jsonData.false_positive_count_updated).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Tenant-Id",
            "value": "{{tenantId}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"False positive override\",\n  \"rolled_back_by\": \"cdo-operator@company.com\",\n  \"rollback_executed_at\": \"2026-06-25T16:00:00Z\",\n  \"rollback_status\": \"SUCCESS\",\n  \"boto3_result\": {\n    \"status\": \"success\",\n    \"details\": \"Rollback executed locally via boto3\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/audit/{{anomalyId}}/rollback",
